// Domain + Auth.js models. Tennis "Session" → PlaySession (avoids Auth Session clash).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlaySessionStatus {
  scheduled
  completed
  cancelled
}

enum AttendanceStatus {
  going
  not_going
  maybe
  pending
}

enum DebtStatus {
  open
  settled
}

enum MatchFormat {
  singles
  doubles
}

/** Loose game (1 pt) vs set to 6 (3 pts). Set score games are not expanded. */
enum MatchUnit {
  game
  set
}

enum WinnerSide {
  A
  B
}

enum MatchChangeAction {
  created
  updated
  deleted
  restored
}

enum GroupVisibility {
  public
  private
}

enum GroupRole {
  owner
  member
}

/** Preferred wallet for P2P debt settlement (no payment gateway). */
enum PaymentWallet {
  yape
  plin
  either
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  displayName   String?
  shortName     String?
  hue           Int       @default(160)
  /** Optional sticker avatar (Vercel Blob public URL). Initials+hue if null. */
  avatarUrl     String?
  /** Peru mobile (9 digits) for Yape/Plin — shared with group members for debts. */
  paymentPhone  String?
  /** Which wallet the user prefers for receiving debt payments. */
  paymentWallet PaymentWallet?
  /** App-wide admin (not group owner). */
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  createdPlaySessions  PlaySession[] @relation("CreatedBy")
  financedPlaySessions PlaySession[] @relation("Financier")
  attendances          Attendance[]
  debtsFrom            Debt[]        @relation("DebtFrom")
  debtsTo              Debt[]        @relation("DebtTo")
  debtsSettled         Debt[]        @relation("DebtSettledBy")
  matchChangeLogs      MatchChangeLog[]
  softDeletedMatches   Match[]       @relation("MatchDeletedBy")

  createdGroups Group[]       @relation("GroupCreator")
  memberships   GroupMember[]

  pushSubscriptions         PushSubscription[]
  notificationPreference    NotificationPreference?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Group {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  description  String?
  visibility   GroupVisibility @default(private)
  passwordHash String?
  inviteCode   String          @unique
  /** Cap on GroupMember rows; join fails when at capacity */
  maxMembers   Int             @default(20)
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  createdBy   User           @relation("GroupCreator", fields: [createdById], references: [id])
  members     GroupMember[]
  playSessions PlaySession[]
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole @default(member)
  joinedAt  DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model PlaySession {
  id          String            @id @default(cuid())
  groupId     String
  startsAt    DateTime
  courtLabel  String?
  costAmount  Decimal           @db.Decimal(10, 2)
  currency    String            @default("PEN")
  /** When true, financier gifts the court — no debts for going players. */
  financierCoversAll Boolean    @default(false)
  status      PlaySessionStatus @default(scheduled)
  note        String?
  /** null = sin cupo; solo cuenta status going */
  maxAttendees Int?
  /** vacío = todos los miembros; si hay ids, solo ellos pueden marcar Voy */
  allowedUserIds String[]       @default([])
  financierId String
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  financier   User         @relation("Financier", fields: [financierId], references: [id])
  createdBy   User         @relation("CreatedBy", fields: [createdById], references: [id])
  attendances     Attendance[]
  debts           Debt[]
  matches         Match[]
  matchChangeLogs MatchChangeLog[]

  @@index([groupId, startsAt])
}

model Attendance {
  id            String           @id @default(cuid())
  playSessionId String
  userId        String
  status        AttendanceStatus @default(pending)
  updatedAt     DateTime         @updatedAt
  createdAt     DateTime         @default(now())

  playSession PlaySession @relation(fields: [playSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playSessionId, userId])
}

model Debt {
  id            String     @id @default(cuid())
  playSessionId String
  fromUserId    String
  toUserId      String
  amount        Decimal    @db.Decimal(10, 2)
  status        DebtStatus @default(open)
  settledAt     DateTime?
  /** Who marked it settled (creditor or app admin). Null = legacy / unknown. */
  settledById   String?
  /** Debtor tapped "Ya pagué" — awaiting creditor settle. Cleared when settled. */
  paymentClaimedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  playSession PlaySession @relation(fields: [playSessionId], references: [id], onDelete: Cascade)
  fromUser    User        @relation("DebtFrom", fields: [fromUserId], references: [id])
  toUser      User        @relation("DebtTo", fields: [toUserId], references: [id])
  settledBy   User?       @relation("DebtSettledBy", fields: [settledById], references: [id], onDelete: SetNull)

  @@index([playSessionId, status])
}

model Match {
  id            String      @id @default(cuid())
  playSessionId String
  format        MatchFormat
  unit          MatchUnit   @default(set)
  sideA         String[]
  sideB         String[]
  /** Empty while in progress (En curso). Set e.g. "6-4"; game "1-0". */
  score         String      @default("")
  /** null = En curso (players set, no winner yet). Does not count for ranking. */
  winnerSide    WinnerSide?
  /** Optional server for loose games (side A or B). Ignored for sets. */
  serverSide    WinnerSide?
  /** Soft-delete: hidden from results/ranking but kept for audit + restore. */
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime    @default(now())

  playSession PlaySession      @relation(fields: [playSessionId], references: [id], onDelete: Cascade)
  deletedBy   User?            @relation("MatchDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  changeLogs  MatchChangeLog[]

  @@index([playSessionId, unit])
  @@index([playSessionId, deletedAt])
}

/** Append-only audit of result changes on a fecha (anti-cheat / transparency). */
model MatchChangeLog {
  id            String            @id @default(cuid())
  playSessionId String
  matchId       String?
  actorId       String
  action        MatchChangeAction
  unit          MatchUnit
  /** Spanish summary for UI, e.g. "Borró Game: Ana ganó a Bruno". */
  summary       String
  before        Json?
  after         Json?
  createdAt     DateTime          @default(now())

  playSession PlaySession @relation(fields: [playSessionId], references: [id], onDelete: Cascade)
  match       Match?      @relation(fields: [matchId], references: [id], onDelete: SetNull)
  actor       User        @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([playSessionId, createdAt])
}

/** Latest Miraflores court availability pushed by the PC bot */
model AvailabilitySnapshot {
  id        String   @id @default("latest")
  /** { "YYYY-MM-DD": { "HH:MM:SS": ["30","32"], ... } } */
  slots     Json
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Browser Web Push subscription (multi-device: one row per endpoint). */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/** Per-user toggles for which push events to receive (global, not per-group). */
model NotificationPreference {
  userId                 String  @id
  fechaCreated           Boolean @default(true)
  fechaUpdated           Boolean @default(true)
  fechaDeleted           Boolean @default(true)
  attendanceChanged      Boolean @default(true)
  resultAdded            Boolean @default(true)
  rankingLeaderChanged   Boolean @default(true)
  debtSettled            Boolean @default(true)
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
