# Environment — copy to `.env` and fill in (never commit `.env`)

# Neon — Dashboard → Connection details
# DATABASE_URL = pooled connection (has `-pooler` in host) — used by the app
# DIRECT_URL   = direct connection (no pooler) — used by Prisma migrate
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (and later https://YOUR_DOMAIN/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional explicit URL (Vercel sets this automatically in prod)
# AUTH_URL="http://localhost:3000"

# PC bot → POST /api/availability/sync (same value as bot RALLY_CRON_SECRET)
CRON_SECRET=""

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Public key is also served via GET /api/push/vapid-public-key
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URI required by the Web Push protocol (mailto: or https:)
VAPID_SUBJECT="mailto:you@example.com"

# Vercel Blob — sticker avatars (Vercel → Storage → Blob → token)
# Local: create a Blob store in the Vercel project and paste the RW token
BLOB_READ_WRITE_TOKEN=""
